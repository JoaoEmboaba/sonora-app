digraph Sonora {
    graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.8, ranksep=1.0];
    node [shape=plain, fontname="Arial"];
    edge [fontname="Arial", fontsize=10, color="#333333"];

    Plataforma [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD BGCOLOR="#E8EEF7"><B>Plataforma</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ cadastrarMusica()</TD></TR>
            <TR><TD ALIGN="LEFT">+ cadastrarUsuario()</TD></TR>
            <TR><TD ALIGN="LEFT">+ buscarMusica()</TD></TR>
        </TABLE>
    >];

    Musica [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD BGCOLOR="#E8EEF7"><B>Musica</B></TD></TR>
            <TR><TD ALIGN="LEFT">- id : int</TD></TR>
            <TR><TD ALIGN="LEFT">- titulo : String</TD></TR>
            <TR><TD ALIGN="LEFT">- artista : String</TD></TR>
            <TR><TD ALIGN="LEFT">- duracaoSegundos : int</TD></TR>
        </TABLE>
    >];

    Usuario [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD BGCOLOR="#E8EEF7"><B>Usuario</B></TD></TR>
            <TR><TD ALIGN="LEFT">- id : int</TD></TR>
            <TR><TD ALIGN="LEFT">- nome : String</TD></TR>
            <TR><TD ALIGN="LEFT">- email : String</TD></TR>
            <TR><TD ALIGN="LEFT">- seguindo : ArrayList&lt;Usuario&gt;</TD></TR>
            <TR><TD ALIGN="LEFT">+ seguir(outro)</TD></TR>
            <TR><TD ALIGN="LEFT">+ deixarDeSeguir(outro)</TD></TR>
        </TABLE>
    >];

    Playlist [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD BGCOLOR="#E8EEF7"><B>Playlist</B></TD></TR>
            <TR><TD ALIGN="LEFT">- nome : String</TD></TR>
            <TR><TD ALIGN="LEFT">- dono : Usuario</TD></TR>
            <TR><TD ALIGN="LEFT">- musicas : ArrayList&lt;Musica&gt;</TD></TR>
        </TABLE>
    >];

    Plataforma -> Musica [label="cadastra", taillabel="1\nplataforma", headlabel="0..*\nacervo", labeldistance=1.7, labelangle=25, arrowhead=vee];
    Plataforma -> Usuario [label="registra", taillabel="1\nplataforma", headlabel="0..*\nusuarios", labeldistance=1.7, labelangle=25, arrowhead=vee];
    Usuario -> Playlist [label="cria", taillabel="1\ndono", headlabel="0..*\nplaylists", labeldistance=1.7, labelangle=25, arrowhead=vee];
    Playlist -> Musica [label="contém", taillabel="1\nplaylist", headlabel="0..*\nmúsicas", labeldistance=1.7, labelangle=25, arrowhead=vee];
    Usuario -> Usuario [label="segue", taillabel="0..*\nseguindo", headlabel="0..*\nseguidores", labeldistance=1.8, labelangle=25, arrowhead=vee];
}
